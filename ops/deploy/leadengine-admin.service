[Unit]
Description=SolutionAI lead engine: Admin pages, JSON API, platform events, MCP (127.0.0.1:8790)
After=network-online.target
Wants=network-online.target

[Service]
User=leadengine
WorkingDirectory=/opt/ai-lead-engine/services
EnvironmentFile=/opt/ai-lead-engine/.env
ExecStart=/usr/bin/env node src/cli.js admin
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/var/log/leadengine/admin.log
StandardError=append:/var/log/leadengine/admin.log
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
