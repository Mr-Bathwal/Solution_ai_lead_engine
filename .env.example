# Copy to .env and fill in. Never commit the real file.

# MongoDB: the existing cluster, with a NEW database for the lead engine.
MONGODB_URI=mongodb://127.0.0.1:27017
LEAD_DB=solutionai_leads

# Raw page and file store. A local folder in development, S3 in production:
#   RAW_STORE=s3://solutionai-lead-engine/raw
RAW_STORE=./data/raw

# How the crawler identifies itself to the sites it reads.
CRAWLER_USER_AGENT=SolutionAI-LeadEngine/1.0 (+https://solutionai.in)

# Hosts whose TLS certificate is not checked (comma-separated), for a government site with a broken
# certificate chain. Leave empty unless a source cannot be read otherwise.
INSECURE_HOSTS=

# "development" on a developer's laptop only: it lets the need engine use the public development
# holdout salt. Never set in production, where HOLDOUT_SALT must be set instead.
# LEADENGINE_ENV=development

# Job worker identity (defaults to hostname:pid).
# WORKER_ID=engine-1

# The secret behind every contact key: suppression entries and the consent ledger's contact_key are
# HMAC-SHA256 of the address under it, so a copy of the database cannot be reversed into phone numbers
# and emails. At least 32 random characters, the same on every process, kept outside the database.
# Set it once: changing it later needs a re-keying migration. The ledger, the suppression list and
# the status, ledger:*, suppress and check commands refuse to start without it.
#   openssl rand -hex 32
CONTACT_KEY_SECRET=

# An append-only file outside the database (chattr +a mount, object-locked bucket, another machine)
# where `ledger:anchor` appends the consent ledger's head every day and `ledger:verify` checks it.
LEDGER_ANCHOR_FILE=

# ---- Week 2 -------------------------------------------------------------------------------------

# Holdout draw (design 7.4). Set ONCE in production, before the first real draw, and never change it:
# it decides which companies are never contacted. Any long random string, kept secret. Without it
# (and without LEADENGINE_ENV=development) the need engine refuses to run.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOLDOUT_SALT=

# MCA data vendor (Infyner). pk_test_... is the free sandbox (answers are cached apart and never
# written to company records); pk_live_... spends credits, within the caps in config/caps.json.
# Leave empty and the vendor steps are skipped.
INFYNER_API_KEY=

# The platform's rules engine, once its endpoint exists (contract in docs/PLATFORM_CONTRACTS.md).
# Until then scheme verdicts come from config/rules/schemes.json and are marked provisional.
RULES_ENGINE_URL=
RULES_ENGINE_KEY=

# Admin pages: node services/src/cli.js admin
# One entry per person, separated by ";", made with: node services/src/cli.js admin:user <email> <viewer|reviewer|admin>
# Each entry is email,role,sha256-of-token[,epoch]. Raising a person's epoch (or giving them a new
# token) ends every session they have open.
ADMIN_USERS=
# At least 32 random characters; changing it signs everyone out.
ADMIN_SESSION_SECRET=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8790
# 1 when served over HTTPS (behind the platform's proxy): adds Secure to the cookie and sends HSTS.
ADMIN_SECURE_COOKIES=0
# 1 only behind a proxy you run: sign-in throttling then keys on the last X-Forwarded-For address.
ADMIN_TRUST_PROXY=0
# Signing in through the platform (docs/PLATFORM_CONTRACTS.md, section 2). Either or both:
#  - the platform's proxy signs who the person is on each request with this shared secret (32+ chars);
#    lead-engine admin:platform-headers <email> <role> prints the headers it must add, as curl
PLATFORM_SSO_SECRET=
#  - the portal's backend calls the JSON API with a service token and names the person in X-Acting-User.
#    Entries name,max-role,sha256 separated by ";", made with: lead-engine admin:service portal reviewer
ADMIN_SERVICE_TOKENS=
# The portal's origin(s), comma-separated, when its proxy rewrites the Host header (form posts check Origin).
ADMIN_ALLOWED_ORIGINS=
# Where "Sign out" takes a person who came in through the platform (its own sign-out page).
PLATFORM_SIGNOUT_URL=
# Where the Admin upload page puts MCA's monthly file for the nightly run (default data/mca/inbox).
MCA_INBOX=
# Backups (lead-engine backup): the local folder (default data/backups), and the S3 location cron copies it to,
# e.g. s3://solutionai-leadengine-backups/prod. The bucket: private, encrypted, objects expire after 35 days.
BACKUP_DIR=
BACKUP_S3_URI=
# Checking addresses before a first email (design 7.3). Optional: without these, only the free checks run
# (format, throwaway domains, MX). zerobounce or millionverifier; at most caps.json monthly.email_verifications_paid a month.
EMAIL_VERIFY_PROVIDER=
EMAIL_VERIFY_API_KEY=
# Finding shortlisted companies' websites (design 7.1): a search API's free tier, at most caps.json monthly.web_searches.
# google_cse (with WEB_SEARCH_CX, the Programmable Search Engine id) or brave. Without these, only websites the
# portals gave are read for a company address. Try one: python -m leadengine enrich search-probe "Gomti Agro Foods"
WEB_SEARCH_PROVIDER=
WEB_SEARCH_KEY=
WEB_SEARCH_CX=

# ---- Week 3: outreach, the company pages, reminders -------------------------------------------

# Where email goes. "outbox" (the default) writes each approved email to OUTBOX_DIR and sends
# nothing; "smtp" sends through the mailboxes below. Keep outbox until the warm-up is over and the
# checks in ops/WEEK3_ACTIONS.md are done: the worker refuses to start in smtp mode while any is missing.
OUTREACH_TRANSPORT=outbox
# OUTBOX_DIR=./data/outbox
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465

# The two outreach mailboxes (caps.json email.mailbox_ids): the person each one belongs to, and the
# Zoho app-specific password for SMTP (never the account password).
MAILBOX_1_ADDRESS=
MAILBOX_1_NAME=
MAILBOX_1_TITLE=
MAILBOX_1_SMTP_PASSWORD=
MAILBOX_2_ADDRESS=
MAILBOX_2_NAME=
MAILBOX_2_TITLE=
MAILBOX_2_SMTP_PASSWORD=
# Only if the SMTP login is not the mailbox address itself (MAILBOX_n_SMTP_USER, n = 1 or 2).
# MAILBOX_1_SMTP_USER=
# MAILBOX_2_SMTP_USER=
# The DKIM selector preflight looks up for the outreach domain (Zoho's default is zmail).
# DKIM_SELECTOR=zmail

# The company pages, claim form and unsubscribe links: node services/src/cli.js pages
# PUBLIC_BASE_URL is the https address founders see (the platform's proxy forwards it to PUBLIC_PORT).
PUBLIC_BASE_URL=
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8791
# 1 only behind a proxy you run: rate limits then key on the last X-Forwarded-For address.
PUBLIC_TRUST_PROXY=0
# At least 32 random characters: signs the claim and unsubscribe forms.
PAGE_SECRET=
# Shown on the claim form: the privacy notice and where to write to withdraw.
PRIVACY_NOTICE_URL=
PRIVACY_CONTACT=

# The platform's LLM gateway (OpenAI-compatible chat completions; docs/PLATFORM_CONTRACTS.md).
# Empty: drafts come from the reviewed templates. Spending is capped by caps.json monthly.llm_spend_inr.
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
# What "small" and "strong" mean on the gateway (config/llm.json); empty uses the aliases as names.
LLM_MODEL_SMALL=
LLM_MODEL_STRONG=

# The platform: pre-filled sign-up when a founder claims a page, and reminders for signed-up founders.
# Without PLATFORM_ONBOARDING_URL the founder goes to PLATFORM_SIGNUP_URL (or the website).
PLATFORM_API_KEY=
PLATFORM_ONBOARDING_URL=
PLATFORM_SIGNUP_URL=
PLATFORM_NOTIFY_URL=

# Meta WhatsApp Cloud API, once business verification is done. Empty: WhatsApp messages are written
# to the outbox as JSON lines and nothing is sent.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=
# Meta's webhook (STOP replies, delivery reports, template pauses) at PUBLIC_BASE_URL/hooks/whatsapp:
# the app secret signs every event; the verify token answers Meta's subscription check.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- Phase 4 -------------------------------------------------------------------------------------
# Reading the outreach mailboxes (read-only IMAP). The SMTP app passwords above work here too; set
# MAILBOX_n_IMAP_PASSWORD only for a separate one.
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
MAILBOX_1_IMAP_PASSWORD=
MAILBOX_2_IMAP_PASSWORD=

# The AI voice agent (config/voice.json, which keeps it switched off until the DLT number and the
# script sign-off are in place). Sarvam's ids come from its dashboard; the connection is the Exotel line.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
# Only to point at another Sarvam endpoint than config/voice.json api_base (a sandbox, say).
# SARVAM_API_BASE=
# The DLT-registered 140-series (or 1600-series) number the calls come from.
VOICE_CALLER_NUMBER=

# The platform signs the sign-ups, service requests and payments it sends to /api/events
# (docs/PLATFORM_CONTRACTS.md, section 4). At least 32 random characters, shared with the platform.
PLATFORM_EVENTS_SECRET=

# The team's daily summary (comma-separated addresses), and where the Parquet exports are synced.
SUMMARY_TO=
EXPORT_S3_URI=

# Staging only: the warm-up-free caps file `staging:seed` writes (data/staging/caps.json). Refused for any
# database whose name does not end in _staging, so the real engine always runs on config/caps.json.
# CAPS_FILE=
